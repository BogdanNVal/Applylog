# Copy to .env. Don't commit real values.

# Session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APPLYLOG_SECRET_KEY=change-me

# Matches docker-compose.yml. In production, use the pooled URL from your host.
APPLYLOG_DATABASE_URL=postgresql://applylog:devpass@127.0.0.1:5433/applylog

# 1 if you're serving over HTTPS (marks the cookie Secure).
APPLYLOG_HTTPS_ONLY=0
