# Copy to .env (or set these in your host's dashboard) - never commit real values.

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APPLYLOG_SECRET_KEY=change-me

# Postgres connection string. This default matches docker-compose.yml.
# In production use the pooled connection string from your provider.
APPLYLOG_DATABASE_URL=postgresql://applylog:devpass@127.0.0.1:5433/applylog

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
APPLYLOG_HTTPS_ONLY=0
